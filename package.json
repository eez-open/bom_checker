{
    "name": "eez-bom-checker",
    "productName": "EEZ BOM checker",
    "desktopName": "eez-bom-checker.desktop",
    "version": "0.13.0",
    "description": "BOM checker with .csv import, KiCad import/update/sync, BOM lists, best price calculation and export",
    "author": "Envox <eez@envox.hr>",
    "license": "MIT",
    "homepage": "https://github.com/eez-open/bom_checker",
    "repository": "https://github.com/eez-open/bom_checker",
    "private": true,
    "main": "./out/main/index.js",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
        "icon": "electron scripts/render-icon.cjs",
        "pack": "npm run build && electron-builder --dir",
        "dist:win": "npm run build && electron-builder --win",
        "dist:linux": "npm run build && electron-builder --linux"
    },
    "prettier": {
        "printWidth": 80,
        "tabWidth": 4,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "overrides": [
            {
                "files": "*.{yml,yaml}",
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    },
    "dependencies": {
        "electron-log": "^5.4.4",
        "fflate": "^0.8.3",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@types/node": "^24.0.0",
        "@types/papaparse": "^5.5.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "ag-grid-community": "^36.2.0",
        "ag-grid-react": "^36.2.0",
        "electron": "^45.0.0",
        "electron-builder": "^26.18.0",
        "electron-vite": "^6.0.0",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "papaparse": "^5.7.0",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "zustand": "^5.0.16"
    }
}
